@using MagicLibrary.Domain.Models
@model MagicLibrary.Domain.Models.Goal

@{
    var misLibros = ViewBag.MisLibros as List<Book> ?? new List<Book>();
    var recomendaciones = ViewBag.Recommendation as List<Recommendation> ?? new List<Recommendation>();
}

<div class="goal-container">
    <header class="goal-header">
        <h1 class="goal-title">Mis Metas de Lectura</h1>
        <div class="auto-notification-badge" style="font-size: 0.85rem; color: var(--terracota); font-weight: bold; text-transform: uppercase;">
            Notificaciones automáticas: @Model.HoraNotificacion hrs
        </div>
    </header>

    <section class="goal-config-section mb-4">
        <h2 class="section-subtitle" style="font-size: 1.2rem; text-transform: uppercase; font-weight: bold;">Programar Hábitos y Horario</h2>
        
        <form asp-controller="Goal" asp-action="ConfigurarMeta" method="post" class="goal-config-form">
            <div class="form-group">
                <label for="nuevaCantidad">Meta de libros al año:</label>
                <input type="number" id="nuevaCantidad" name="nuevaCantidad" value="@Model.CantidadObjetivo" min="1" required />
            </div>

            <div class="form-group">
                <label for="diasPorSemana">Días a la semana de lectura:</label>
                <select id="diasPorSemana" name="diasPorSemana">
                    <option value="1" selected="@(Model.DiasPorSemana == 1)">1 día a la semana</option>
                    <option value="3" selected="@(Model.DiasPorSemana == 3)">3 días a la semana</option>
                    <option value="5" selected="@(Model.DiasPorSemana == 5)">5 días a la semana</option>
                    <option value="7" selected="@(Model.DiasPorSemana == 7)">Todos los días</option>
                </select>

                <!-- PÁRRAFO QUE MUESTRA LOS DÍAS EXACTOS DE NOTIFICACIÓN -->
                <p id="dias-notificacion-texto" style="font-size: 0.85rem; color: var(--azul-profundo, #2c3e50); font-style: italic; margin-top: 6px; font-weight: 500;">
                    <!-- Se llena automáticamente con JS -->
                </p>
            </div>

            <div class="form-group">
                <label for="horaNotificacion">Hora de recordatorio automático:</label>
                <input type="time" id="horaNotificacion" name="horaNotificacion" value="@Model.HoraNotificacion" required />
            </div>

            <button type="submit" class="btn-agregar-libro">Guardar Horario y Meta</button>
        </form>
    </section>

    <!-- SCRIPT DE JAVASCRIPT PARA EVALUAR LOS DÍAS -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const selectDias = document.getElementById('diasPorSemana');
                const textoDias = document.getElementById('dias-notificacion-texto');

                function actualizarDias() {
                    if (!selectDias || !textoDias) return;
                    const valor = parseInt(selectDias.value);
                    let mensaje = "";
                
                    if (valor === 1) mensaje = "Se enviarán notificaciones los Domingos.";
                    else if (valor === 3) mensaje = "Se enviarán notificaciones Lunes, Miércoles y Viernes.";
                    else if (valor === 5) mensaje = "Se enviarán notificaciones de Lunes a Viernes.";
                    else if (valor === 7) mensaje = "Se enviarán notificaciones todos los días.";
                    else mensaje = "Distribución automática de notificaciones.";

                    textoDias.textContent = mensaje;
                }

                if (selectDias) {
                    selectDias.addEventListener('change', actualizarDias);
                    actualizarDias();
                }
            });
    </script>

    <hr />

    <section class="goal-stats-section">
        <div class="stat-card">
            <span class="stat-label">Meta Anual (@Model.Anio)</span>
            <span class="stat-value">@Model.CantidadObjetivo</span>
        </div>

        <div class="stat-card">
            <span class="stat-label">Libros Asignados</span>
            <span class="stat-value">@Model.LibrosAsignados.Count / @Model.CantidadObjetivo</span>
        </div>

        <div class="stat-card">
            <span class="stat-label">Frecuencia</span>
            <span class="stat-value">@Model.DiasPorSemana días/sem</span>
        </div>

        <div class="stat-card">
            <span class="stat-label">Lectura Diaria</span>
            <span class="stat-value">
                @(ViewBag.TotalPaginas == 0 ? 0 : Math.Ceiling((double)ViewBag.TotalPaginas / ViewBag.DiasRestantes)) pág/día
            </span>
        </div>
    </section>

    <section class="goal-progress-section">
        <h3 class="section-title" style="font-size: 1.2rem; text-transform: uppercase; font-weight: bold;">Lista de Libros en la Meta</h3>

        @if (!Model.LibrosAsignados.Any())
        {
            <p class="empty-message" style="color: var(--texto-suave);">Aún no has asignado ningún libro a tu meta anual.</p>
        }
        else
        {
            <ul class="goal-items-list" style="list-style: none; padding: 0;">
                @foreach (var lib in Model.LibrosAsignados)
                {
                    <li class="goal-item @(lib.EstaCompletado ? "item-completed" : "item-pending")">
                        <div class="item-main-info" style="display: flex; align-items: center; gap: 15px;">
                            @if (!lib.EstaCompletado)
                            {
                                <form asp-controller="Goal" asp-action="MarcarCompletado" method="post" style="display:inline;">
                                    <input type="hidden" name="tituloLibro" value="@lib.Titulo" />
                                    <button type="submit" class="filtro-btn"
                                            onclick="return confirm('¿Estás seguro de marcar «@lib.Titulo» como terminado?')"
                                            title="Marcar como completado">
                                        COMPLETAR
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span style="font-weight: bold; color: var(--verde-salvia);">[COMPLETADO]</span>
                            }
                            <span class="item-title" style="font-weight: bold;">@lib.Titulo</span>
                        </div>

                        <div class="item-actions">
                            <form asp-controller="Goal" asp-action="EliminarItem" method="post" style="display:inline;">
                                <input type="hidden" name="tituloLibro" value="@lib.Titulo" />
                                <button type="submit" class="btn-borrar"
                                        onclick="return confirm('¿Seguro que deseas quitar «@lib.Titulo» de tu meta anual?')">
                                    Quitar
                                </button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    @if (Model.LibrosAsignados.Count < Model.CantidadObjetivo)
    {
        <hr />
        <section class="goal-assign-section">
            <h3 class="section-title" style="font-size: 1.2rem; text-transform: uppercase; font-weight: bold;">Asignar Libro a Espacio Libre</h3>
            
            <div class="grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 0;">
                <div class="tarjeta-contenido">
                    <h4>Desde Mis Libros</h4>
                    <form asp-controller="Goal" asp-action="AgregarItem" method="post">
                        <select name="MiLibroId" required style="margin-bottom: 15px;">
                            <option value="">-- Selecciona un libro --</option>
                            @foreach (var lib in misLibros)
                            {
                                <option value="@lib.IdLibro">@lib.Titulo (@lib.Paginas págs) - [@lib.Estado]</option>
                            }
                        </select>
                        <button type="submit" class="btn-agregar-libro" style="width: 100%;">Añadir de Mis Libros</button>
                    </form>
                </div>

                <div class="tarjeta-contenido">
                    <h4>Desde Recomendaciones</h4>
                    <form asp-controller="Goal" asp-action="AgregarItem" method="post">
                        <select name="RecomendacionId" required style="margin-bottom: 15px;">
                            <option value="">-- Selecciona una recomendación --</option>
                            @foreach (var rec in recomendaciones)
                            {
                                <option value="@rec.Id">@rec.TituloLibro (@rec.Paginas págs)</option>
                            }
                        </select>
                        <button type="submit" class="btn-agregar-libro" style="width: 100%;">Añadir de Recomendaciones</button>
                    </form>
                </div>
            </div>
        </section>
    }
</div>