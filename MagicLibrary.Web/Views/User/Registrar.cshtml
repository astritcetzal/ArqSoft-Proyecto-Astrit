@model MagicLibrary.Domain.Models.User
@{
    ViewData["Title"] = "Registrarse";
    Layout = null;
    <link rel="stylesheet" href="~/css/site.css" />
}

<div class="formulario-registro">
    <h1>Registrarse</h1>
    
    <form asp-controller="User" asp-action="Registrar" method="post">
        <div class="grupo-input">
            <label asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" required placeholder="Tu nombre" />
        </div>

        <div class="grupo-input">
            <label asp-for="Correo">Correo</label>
            <input asp-for="Correo" required placeholder="correo@ejemplo.com" />
        </div>

        <div class="grupo-input">
            <label asp-for="Contrasena">Contraseña</label>
            <input asp-for="Contrasena" type="password" required />
        </div>

        <hr style="margin: 20px 0; border: none; border-top: 1px solid #E6E2D8;" />

        <button type="submit" class="btn-guardar">Registrar</button>
    </form>

    <hr style="margin: 20px 0; border: none; border-top: 1px solid #E6E2D8;" />

    <div style="text-align: center;">
        <a asp-controller="Home" asp-action="PrincipalInicio" class="link-cancelar" style="margin-left: 0;">&larr; Cancelar</a>
    </div>
</div>